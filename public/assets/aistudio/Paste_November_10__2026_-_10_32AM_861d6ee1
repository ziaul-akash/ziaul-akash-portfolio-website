  Radio 
} from 'lucide-react';

export const Skills: React.FC = () => {
  const [filterText, setFilterText] = useState('');

  // Icon mapping for each numbered category
  const getCategoryIcon = (categoryNumber: number) => {
    switch (categoryNumber) {
      case 1: return <Cloud className="w-5 h-5 text-cyan-400" />;
      case 2: return <Radio className="w-5 h-5 text-sky-400" />;
      case 3: return <Layers className="w-5 h-5 text-blue-400" />;
      case 4: return <Cpu className="w-5 h-5 text-indigo-400" />;
      case 5: return <Code2 className="w-5 h-5 text-emerald-400" />;
      case 6: return <Database className="w-5 h-5 text-amber-400" />;
      case 7: return <BarChart3 className="w-5 h-5 text-cyan-300" />;
      case 8: return <ShieldCheck className="w-5 h-5 text-purple-400" />;
      case 9: return <Workflow className="w-5 h-5 text-teal-400" />;
      default: return <Cloud className="w-5 h-5 text-cyan-400" />;
    }
  };

  const filteredCategories = skillsCategories.map((cat) => {
    if (!filterText.trim()) return cat;
    const matchingSkills = cat.skills.filter((s) =>
      s.toLowerCase().includes(filterText.toLowerCase())
    );
    return {
      ...cat,
      skills: matchingSkills
    };
  }).filter((cat) => cat.skills.length > 0);

  return (
    <section id="skills" className="py-24 bg-white dark:bg-[#080D18] relative">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        {/* Section Heading */}
        <div className="text-center max-w-3xl mx-auto mb-12">
          <p className="text-xs font-mono font-semibold uppercase tracking-widest text-cyan-600 dark:text-[#38BDF8] mb-2">
            Technical Stack & Ecosystem
          </p>
          <h2 className="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-[#F8FAFC]">
            End-to-End Data Engineering Competencies
          </h2>
          <p className="text-sm text-slate-600 dark:text-[#94A3B8] mt-3">
            Organised by cloud data architecture domains. Real-world technologies applied across production pipelines.
          </p>
          <div className="mt-3 w-16 h-1 bg-gradient-to-r from-cyan-400 to-blue-500 mx-auto rounded-full" />
        </div>

        {/* Live Search Filter */}
        <div className="max-w-md mx-auto mb-12">
          <input
            type="text"
            placeholder="Search technology (e.g. PySpark, OneLake, Delta, KQL)..."
            value={filterText}
            onChange={(e) => setFilterText(e.target.value)}
            className="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-300 dark:border-[#263449] bg-slate-50 dark:bg-[#141F30] text-slate-900 dark:text-[#F8FAFC] focus:outline-none focus:ring-2 focus:ring-cyan-500 placeholder-slate-400 transition-all"
          />
        </div>

        {/* 9 Categories Grid */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {filteredCategories.map((cat) => (
            <div
              key={cat.categoryNumber}
              className="group p-6 rounded-2xl border border-slate-200 dark:border-[#263449] bg-slate-50/50 dark:bg-[#141F30] hover:border-cyan-500/40 transition-all duration-300 hover:shadow-lg dark:hover:shadow-cyan-900/10 flex flex-col justify-between"
            >
              <div>
