src/components/Projects.tsx

import React, { useState } from 'react';
import { projectsData } from '../data/projectsData';
import { ProjectDetail } from '../types';
import { ProjectDetailModal } from './ProjectDetailModal';
import { Lightbox } from './Lightbox';
import { Github, ArrowRight, Layers, Sparkles } from 'lucide-react';

export const Projects: React.FC = () => {
  const [selectedProject, setSelectedProject] = useState<ProjectDetail | null>(null);
  const [activeCategory, setActiveCategory] = useState<string>('All');
  const [lightboxState, setLightboxState] = useState<{ isOpen: boolean; src: string; caption: string }>({
    isOpen: false,
    src: '',
    caption: ''
  });

  const categories = ['All', 'Microsoft Fabric', 'Azure Data Engineering'];

  const filteredProjects = activeCategory === 'All'
    ? projectsData
    : projectsData.filter((p) => p.category === activeCategory);

  const handleOpenLightbox = (src: string, caption: string) => {
    setLightboxState({ isOpen: true, src, caption });
  };

  return (
    <section id="projects" className="py-24 bg-white dark:bg-[#080D18] relative">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        {/* Section Heading */}
        <div className="text-center max-w-3xl mx-auto mb-12">
          <p className="text-xs font-mono font-semibold uppercase tracking-widest text-cyan-600 dark:text-[#38BDF8] mb-2">
            Production Data Platforms
          </p>
          <h2 className="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-[#F8FAFC]">
            Featured Engineering Projects
          </h2>
          <p className="text-sm text-slate-600 dark:text-[#94A3B8] mt-3">
            Real-world lakehouses, incremental PySpark pipelines, AI data agents, and automated Azure data architectures.
          </p>
          <div className="mt-3 w-16 h-1 bg-gradient-to-r from-cyan-400 to-blue-500 mx-auto rounded-full" />
        </div>

        {/* Filter Tabs */}
        <div className="flex items-center justify-center gap-2 mb-14 flex-wrap">
          {categories.map((cat) => (
            <button
              key={cat}
              onClick={() => setActiveCategory(cat)}
              className={`px-4 py-2 text-xs font-semibold rounded-lg transition-all ${
                activeCategory === cat
                  ? 'bg-cyan-500 text-white shadow-md shadow-cyan-500/20'
                  : 'bg-slate-100 dark:bg-[#141F30] text-slate-600 dark:text-[#94A3B8] hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-[#263449]'
              }`}
            >
              {cat}
            </button>
          ))}
        </div>

        {/* Projects Grid */}
        <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
          {filteredProjects.map((project, idx) => (
            <div
              key={project.id}
              className="group rounded-2xl border border-slate-200 dark:border-[#263449] bg-slate-50/50 dark:bg-[#141F30] overflow-hidden hover:border-cyan-500/50 transition-all duration-300 hover:shadow-xl dark:hover:shadow-cyan-950/20 flex flex-col justify-between"
            >
              <div>
                {/* Visual Cover / Architecture Placeholder */}
                <div className="relative h-48 bg-gradient-to-br from-slate-200 via-slate-100 to-white dark:from-[#101827] dark:via-[#0b121e] dark:to-[#141F30] border-b border-slate-200 dark:border-[#263449] p-6 flex flex-col justify-between overflow-hidden">
                  <div className="flex items-center justify-between z-10">
                    <span className="text-[11px] font-mono font-bold tracking-wider uppercase px-2.5 py-1 rounded bg-white/80 dark:bg-[#141F30]/90 text-cyan-600 dark:text-[#38BDF8] border border-cyan-500/20">
                      PROJECT 0{idx + 1}
                    </span>
                    {project.id === 'ai-powered-learning-ecosystem' && (
                      <span className="inline-flex items-center gap-1 text-[10px] font-mono uppercase bg-amber-500/10 text-amber-500 border border-amber-500/30 px-2 py-0.5 rounded-full">
                        <Sparkles className="w-3 h-3" /> AI-Agent
                      </span>
                    )}
                  </div>

                  <div className="z-10">
                    <h3 className="text-xl font-bold text-slate-900 dark:text-[#F8FAFC] group-hover:text-cyan-500 dark:group-hover:text-[#38BDF8] transition-colors">
                      {project.title}
                    </h3>
                    <p className="text-xs text-slate-500 dark:text-[#94A3B8] font-mono mt-0.5">
                      {project.subtitle}
                    </p>
                  </div>

                  {/* Subtle graphical background pattern */}
                  <div className="absolute right-3 bottom-3 opacity-10 dark:opacity-20 text-cyan-400 pointer-events-none">
                    <Layers className="w-32 h-32" />
                  </div>
                </div>

                {/* Card Body */}
                <div className="p-6 space-y-4">
                  <p className="text-xs sm:text-sm text-slate-600 dark:text-[#94A3B8] leading-relaxed line-clamp-3">
                    {project.shortDescription}
                  </p>

                  {/* Core Impact Highlight */}
                  <div className="space-y-1.5 pt-2">
                    <p className="text-[11px] font-mono uppercase tracking-wider text-slate-400 font-semibold">
                      Key Impact:
                    </p>
                    <ul className="text-xs text-slate-700 dark:text-slate-300 space-y-1">
                      {project.businessImpact.slice(0, 2).map((impact, i) => (
                        <li key={i} className="flex items-start gap-1.5">
                          <span className="text-cyan-500 font-bold">•</span>
                          <span className="line-clamp-1">{impact}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  {/* Tech Stack Pills */}
                  <div className="pt-2 flex flex-wrap gap-1.5">
                    {project.technologies.slice(0, 6).map((tech) => (
                      <span
                        key={tech}
                        className="text-[11px] font-mono px-2 py-0.5 rounded bg-white dark:bg-[#101827] text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-[#263449]"
                      >
                        {tech}
                      </span>
                    ))}
                    {project.technologies.length > 6 && (
                      <span className="text-[11px] font-mono px-1.5 py-0.5 text-slate-400">
                        +{project.technologies.length - 6} more
                      </span>
                    )}
                  </div>
                </div>
              </div>

              {/* Action Buttons */}
              <div className="px-6 pb-6 pt-2 border-t border-slate-100 dark:border-[#263449]/50 flex items-center justify-between gap-3">
                <button
                  onClick={() => setSelectedProject(project)}
                  className="inline-flex items-center gap-1.5 text-xs font-semibold text-cyan-600 dark:text-[#38BDF8] hover:gap-2.5 transition-all"
                >
                  <span>View Full Architecture & Details</span>
                  <ArrowRight className="w-3.5 h-3.5" />
                </button>

                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="p-2 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-[#101827] transition-colors"
                    aria-label={`GitHub Repository for ${project.title}`}
                    title="View GitHub Repository"
                  >
                    <Github className="w-4 h-4" />
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>

      </div>

      {/* Interactive Detail Modal with all 13 sections */}
      <ProjectDetailModal
        project={selectedProject}
        onClose={() => setSelectedProject(null)}
        onOpenLightbox={handleOpenLightbox}
      />

      {/* Image Lightbox */}
      <Lightbox
        isOpen={lightboxState.isOpen}
        src={lightboxState.src}
        caption={lightboxState.caption}
        onClose={() => setLightboxState({ isOpen: false, src: '', caption: '' })}
      />
    </section>
  );
};

